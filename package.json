{
  "name": "thunderclaw",
  "private": true,
  "type": "module",
  "description": "ThunderClaw standalone Thunderbird extension",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "build:site": "node scripts/build-pages.mjs",
    "pack:source": "node scripts/package-extension-source.mjs",
    "pack:release": "npm run build:extension && npm run pack:source",
    "test:e2e:thunderbird": "sh scripts/run-thunderbird-e2e.sh",
    "test:e2e:thunderbird:rich-compose": "sh scripts/run-thunderbird-rich-compose-e2e.sh",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc -p packages/thunderbird-extension/tsconfig.json",
    "check": "node scripts/check.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:status": "node scripts/release-status.mjs",
    "test:provider": "tsx scripts/provider-trials.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "^0.25.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
