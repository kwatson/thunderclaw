# Copy to .env.openclaw.local and supply the real key there.
# Never commit the populated local file.
DEEPSEEK_API_KEY=

# Generate a separate random value for local OpenClaw Gateway administration.
# This credential is consumed by the Gateway and is never shipped in either
# ThunderClaw distribution artifact.
OPENCLAW_GATEWAY_TOKEN=

# Generate a dedicated random value for the narrow extension-facing plugin
# routes, for example with: openssl rand -hex 32
THUNDERCLAW_PLUGIN_TOKEN=
